VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 50000 50000 ) ;
TRACKS X 480 DO 103 STEP 480 LAYER li1 ;
TRACKS Y 480 DO 103 STEP 480 LAYER li1 ;
TRACKS X 370 DO 134 STEP 370 LAYER met1 ;
TRACKS Y 370 DO 134 STEP 370 LAYER met1 ;
TRACKS X 480 DO 104 STEP 480 LAYER met2 ;
TRACKS Y 480 DO 104 STEP 480 LAYER met2 ;
TRACKS X 740 DO 67 STEP 740 LAYER met3 ;
TRACKS Y 740 DO 67 STEP 740 LAYER met3 ;
TRACKS X 960 DO 51 STEP 960 LAYER met4 ;
TRACKS Y 960 DO 51 STEP 960 LAYER met4 ;
TRACKS X 3330 DO 14 STEP 3330 LAYER met5 ;
TRACKS Y 3330 DO 14 STEP 3330 LAYER met5 ;
GCELLGRID X 0 DO 6 STEP 7200 ;
GCELLGRID Y 0 DO 6 STEP 7200 ;
COMPONENTS 1 ;
    - u0 diffpair_nmos_4f + PLACED ( 21000 22000 ) N ;
END COMPONENTS
PINS 6 ;
    - bulk + NET bulk + DIRECTION INOUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -500 ) ( 140 500 )
        + FIXED ( 25000 50000 ) N ;
    - drn_n + NET drn_n + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -500 ) ( 140 500 )
        + FIXED ( 35000 50000 ) N ;
    - drn_p + NET drn_p + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -500 ) ( 140 500 )
        + FIXED ( 15000 50000 ) N ;
    - gate_n + NET gate_n + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -500 ) ( 140 500 )
        + FIXED ( 50000 22000 ) N ;
    - gate_p + NET gate_p + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -500 ) ( 140 500 )
        + FIXED ( 0 22000 ) N ;
    - tail + NET tail + DIRECTION INOUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -500 ) ( 140 500 )
        + FIXED ( 25000 0 ) N ;
END PINS
NETS 6 ;
    - bulk ( PIN bulk ) ( u0 bulk ) + USE SIGNAL
      + ROUTED met2 ( 24960 25070 ) ( * 49580 0 )
      NEW met1 ( 24960 25070 ) M1M2_PR ;
    - drn_n ( PIN drn_n ) ( u0 drn_n ) + USE SIGNAL
      + ROUTED met1 ( 28320 27380 0 ) ( 35040 * )
      NEW met2 ( 35040 27380 ) ( * 49580 0 )
      NEW met1 ( 35040 27380 ) M1M2_PR ;
    - drn_p ( PIN drn_p ) ( u0 drn_p ) + USE SIGNAL
      + ROUTED met2 ( 14880 49580 0 ) ( 16320 * )
      NEW met2 ( 16320 27380 ) ( * 49580 )
      NEW met1 ( 16320 27380 ) ( 21600 * 0 )
      NEW met1 ( 16320 27380 ) M1M2_PR ;
    - gate_n ( PIN gate_n ) ( u0 gate_n ) + USE SIGNAL
      + ROUTED met2 ( 49920 22200 0 ) ( * 23680 )
      NEW met2 ( 49440 23680 ) ( 49920 * )
      NEW met2 ( 49440 23680 ) ( * 24790 )
      NEW met1 ( 30240 24790 ) ( 49440 * )
      NEW met1 ( 30240 24790 ) ( * 24975 )
      NEW met1 ( 28930 24975 0 ) ( 30240 * )
      NEW met1 ( 49440 24790 ) M1M2_PR ;
    - gate_p ( PIN gate_p ) ( u0 gate_p ) + USE SIGNAL
      + ROUTED met2 ( 0 22200 0 ) ( * 23680 )
      NEW met2 ( 0 23680 ) ( 480 * )
      NEW met2 ( 480 23680 ) ( * 24790 )
      NEW met1 ( 480 24790 ) ( 19680 * )
      NEW met1 ( 19680 24790 ) ( * 24975 )
      NEW met1 ( 19680 24975 ) ( 21070 * 0 )
      NEW met1 ( 480 24790 ) M1M2_PR ;
    - tail ( PIN tail ) ( u0 tail ) + USE SIGNAL
      + ROUTED met2 ( 24480 0 ) ( 24960 * 0 )
      NEW met2 ( 24480 0 ) ( * 22570 )
      NEW met1 ( 24480 22570 ) M1M2_PR ;
END NETS
END DESIGN
