VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 50000 50000 ) ;

COMPONENTS 1 ;
  - u0 diffpair_nmos_4f + PLACED ( 21000 22000 ) N ;
END COMPONENTS

PINS 19 ;
  - gate_p + NET gate_p + DIRECTION INPUT + FIXED ( 0 22000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - gate_n + NET gate_n + DIRECTION INPUT + FIXED ( 50000 22000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_p_0 + NET drn_p_0 + DIRECTION OUTPUT + FIXED ( 5000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_p_1 + NET drn_p_1 + DIRECTION OUTPUT + FIXED ( 10000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_p_2 + NET drn_p_2 + DIRECTION OUTPUT + FIXED ( 15000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_p_3 + NET drn_p_3 + DIRECTION OUTPUT + FIXED ( 20000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_n_0 + NET drn_n_0 + DIRECTION OUTPUT + FIXED ( 30000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_n_1 + NET drn_n_1 + DIRECTION OUTPUT + FIXED ( 35000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_n_2 + NET drn_n_2 + DIRECTION OUTPUT + FIXED ( 40000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - drn_n_3 + NET drn_n_3 + DIRECTION OUTPUT + FIXED ( 45000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_0 + NET tail_0 + DIRECTION INOUT + FIXED ( 3000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_1 + NET tail_1 + DIRECTION INOUT + FIXED ( 9000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_2 + NET tail_2 + DIRECTION INOUT + FIXED ( 15000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_3 + NET tail_3 + DIRECTION INOUT + FIXED ( 21000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_4 + NET tail_4 + DIRECTION INOUT + FIXED ( 29000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_5 + NET tail_5 + DIRECTION INOUT + FIXED ( 35000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_6 + NET tail_6 + DIRECTION INOUT + FIXED ( 41000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - tail_7 + NET tail_7 + DIRECTION INOUT + FIXED ( 47000 0 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
  - bulk + NET bulk + DIRECTION INOUT + FIXED ( 25000 50000 ) N + LAYER met2 ( -140 -500 ) ( 140 500 ) ;
END PINS

NETS 19 ;
  - gate_p ( PIN gate_p ) ( u0 gate_p ) ;
  - gate_n ( PIN gate_n ) ( u0 gate_n ) ;
  - drn_p_0 ( PIN drn_p_0 ) ( u0 drn_p_0 ) ;
  - drn_p_1 ( PIN drn_p_1 ) ( u0 drn_p_1 ) ;
  - drn_p_2 ( PIN drn_p_2 ) ( u0 drn_p_2 ) ;
  - drn_p_3 ( PIN drn_p_3 ) ( u0 drn_p_3 ) ;
  - drn_n_0 ( PIN drn_n_0 ) ( u0 drn_n_0 ) ;
  - drn_n_1 ( PIN drn_n_1 ) ( u0 drn_n_1 ) ;
  - drn_n_2 ( PIN drn_n_2 ) ( u0 drn_n_2 ) ;
  - drn_n_3 ( PIN drn_n_3 ) ( u0 drn_n_3 ) ;
  - tail_0 ( PIN tail_0 ) ( u0 tail_0 ) ;
  - tail_1 ( PIN tail_1 ) ( u0 tail_1 ) ;
  - tail_2 ( PIN tail_2 ) ( u0 tail_2 ) ;
  - tail_3 ( PIN tail_3 ) ( u0 tail_3 ) ;
  - tail_4 ( PIN tail_4 ) ( u0 tail_4 ) ;
  - tail_5 ( PIN tail_5 ) ( u0 tail_5 ) ;
  - tail_6 ( PIN tail_6 ) ( u0 tail_6 ) ;
  - tail_7 ( PIN tail_7 ) ( u0 tail_7 ) ;
  - bulk ( PIN bulk ) ( u0 bulk ) ;
END NETS

END DESIGN
